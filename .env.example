# Supabase — Porta 2 (Sala de Comando)
# Reaproveitar o projeto existente "soic-16bpmm-homologacao" OU criar um novo.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# Somente no servidor — ingestão do coletor. NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Login da Sala de Comando (lib/auth-simples.ts). OBRIGATÓRIAS — sem elas o
# login falha fechado (não há valor padrão). Nunca commitar os valores reais.
CCO16_USUARIO=usuario-institucional
CCO16_SENHA=defina-uma-senha-forte
# String aleatória forte (ex.: openssl rand -hex 32) usada para assinar
# (HMAC-SHA256) o cookie de sessão — sem ela o login também falha fechado.
CCO16_SESSAO_SEGREDO=defina-uma-string-aleatoria-forte

# Roteamento do módulo de Despacho (lib/routing.ts). Opcional — sem ela o
# cálculo de "viatura mais próxima" usa distância em linha reta (Haversine)
# em vez de rota real.
OSRM_URL=http://localhost:5000

# Acesso restrito do painel da COP 2026 (lib/cop2026-acesso.ts). Cliente OAuth
# "Portal CCO-16 web" no projeto portal-cco16 do Google Cloud; o callback
# cadastrado lá precisa bater com COP2026_URL_BASE.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
# Origem usada para montar o redirect_uri. Sem ela, vale a origem da requisição.
COP2026_URL_BASE=https://portal-cco16.vercel.app

# Quem administra a lista de autorizados em /cop2026/admin. Deliberadamente
# FORA do banco: é o que impede o administrador de se trancar do lado de fora.
# Separadores: vírgula, ponto e vírgula, espaço ou quebra de linha.
COP2026_ADMINS=fulano@gmail.com

# Semente da primeira carga da lista de autorizados (migration 025). Depois de
# importada pela tela, a fonte que vale é a tabela cop2026_autorizados.
COP2026_EMAILS_AUTORIZADOS=fulano@gmail.com,sicrano@gmail.com

# "1" quando o portal serve em HTTP dentro da intranet do Batalhão: sem isso o
# cookie de sessão sai com Secure e o navegador não o grava.
CCO16_HTTP_INTRANET=0

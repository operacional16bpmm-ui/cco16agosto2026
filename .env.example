# Supabase — Porta 2 (Sala de Comando)
# Reaproveitar o projeto existente "soic-16bpmm-homologacao" OU criar um novo.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima

# Somente no servidor — ingestão do coletor. NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Login da Sala de Comando (lib/auth-simples.ts). OBRIGATÓRIAS — sem elas o
# login falha fechado (não há valor padrão). Nunca commitar os valores reais.
CCO16_USUARIO=usuario-institucional
CCO16_SENHA=defina-uma-senha-forte
# String aleatória forte (ex.: openssl rand -hex 32) usada para assinar
# (HMAC-SHA256) o cookie de sessão — sem ela o login também falha fechado.
CCO16_SESSAO_SEGREDO=defina-uma-string-aleatoria-forte

# Roteamento do módulo de Despacho (lib/routing.ts). Opcional — sem ela o
# cálculo de "viatura mais próxima" usa distância em linha reta (Haversine)
# em vez de rota real.
OSRM_URL=http://localhost:5000
